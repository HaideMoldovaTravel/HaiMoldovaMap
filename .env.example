# Run npm run setup to generate a private .env for local Docker development.
APP_ENV=development
APP_PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_USER=hai_moldova
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hai_moldova
# Local host URLs; Compose overrides hosts for container-to-container access.
DATABASE_URL=postgresql://hai_moldova:replace-password@localhost:5432/hai_moldova
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hai-moldova
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
# One-time bootstrap. Subsequent administrators are invited from /admin.
ADMIN_EMAIL=admin@haimoldova.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_DEMO=true
# For real email: MAIL_TRANSPORT=resend, verified EMAIL_FROM and RESEND_API_KEY.
MAIL_TRANSPORT=mailpit
RESEND_API_KEY=
EMAIL_FROM=Hai Moldova <noreply@haimoldova.local>
SMTP_HOST=localhost
SMTP_PORT=1025
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
# Telegram moderation alerts (optional). Create the bot with @BotFather, then
# pick the group in Admin → Notificări Telegram. The token never leaves .env.
TELEGRAM_BOT_TOKEN=
# Optional defaults; the admin page overrides them.
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
