{
  "name": "map-travel-moldova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests *.mjs *.json README.md",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "import:places": "tsx --env-file-if-exists=.env scripts/import-places.ts",
    "storage:init": "tsx --env-file-if-exists=.env scripts/storage-init.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "setup": "node scripts/setup.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "test:integration": "tsx --env-file=.env scripts/integration-test.ts",
    "sync:haide": "tsx --env-file-if-exists=.env scripts/haide-sync.ts",
    "sync:haide:watch": "tsx --env-file-if-exists=.env scripts/haide-sync.ts --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.33.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
